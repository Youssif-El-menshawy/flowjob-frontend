# FlowJob always uses the FastAPI backend. In development, leave VITE_API_URL unset: Vite proxies /api/v1 to
# localhost:8000 (set FLOWJOB_API when starting Vite to use another backend address).
# Set VITE_API_URL only when the API is served from a different origin. VITE_* values are public: no secrets here.
# VITE_API_URL=http://localhost:8000/api/v1
